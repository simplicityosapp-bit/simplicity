# Server-side secrets for the scripts in this directory. NOT loaded by Vite,
# never shipped to the browser, and never committed — `.env` is gitignored.
#
# Setup:  cp supabase/.env.example supabase/.env   then fill in the password.

# Direct Postgres connection.
#
# YOU PROBABLY DO NOT NEED THIS. Linking the CLI once:
#     supabase link --project-ref rdurkakzyymxhocvhufw
# stores the password in the CLI's own credential store instead of a file here,
# and both `supabase db query --linked` and `node supabase/dump-schema.mjs`
# work off that. Fewer copies of a password is the better arrangement.
#
# Fill this in only for something the CLI cannot do:
#   node supabase/run-schema.mjs    — apply schema.sql to a FRESH database
#   (dump-schema.mjs will also use it, and is faster over one socket)
#
# Where to get it: Supabase dashboard → Project Settings → Database →
# Connection string. Use the **Session pooler** or the direct connection —
# NOT the transaction pooler, which cannot run the catalog queries these
# scripts rely on.
#
# The client-side keys (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY) do NOT go
# here — they live in .env.local at the repo root, which is where Vite's
# envDir points.
SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@db.rdurkakzyymxhocvhufw.supabase.co:5432/postgres
